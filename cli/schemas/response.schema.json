{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moelee835/Impact-Lens/cli/schemas/response.schema.json",
  "title": "Impact Lens Agent CLI response envelope",
  "type": "object",
  "$defs": {
    "provider": {
      "type": "object",
      "required": [
        "host", "name", "requestedLanguageId", "detectedLanguageId", "selectedBy",
        "languageMatch", "callHierarchy", "diagnostics", "advertised", "observed", "lifecycle"
      ],
      "properties": {
        "host": { "enum": ["lsp", "vscode"] },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "requestedLanguageId": { "type": "string" },
        "detectedLanguageId": { "type": "string" },
        "selectedBy": { "enum": ["bundled", "auto", "preset", "project", "custom", "vscode"] },
        "languageMatch": { "oneOf": [{ "type": "boolean" }, { "const": "unknown" }] },
        "callHierarchy": { "type": "boolean" },
        "diagnostics": { "type": "boolean" },
        "advertised": {
          "type": "object",
          "required": ["callHierarchy", "diagnostics"],
          "properties": {
            "callHierarchy": { "oneOf": [{ "type": "boolean" }, { "const": "unknown" }] },
            "diagnostics": { "oneOf": [{ "type": "boolean" }, { "const": "unknown" }] }
          },
          "additionalProperties": false
        },
        "observed": {
          "type": "object",
          "required": ["prepareCallHierarchy", "incomingCalls", "diagnostics"],
          "properties": {
            "prepareCallHierarchy": { "type": "boolean" },
            "incomingCalls": { "type": "boolean" },
            "diagnostics": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "lifecycle": {
          "type": "object",
          "required": ["stage", "status"],
          "properties": {
            "stage": { "enum": ["discovery", "launch", "initialize", "indexing", "capability", "query"] },
            "status": { "enum": ["working", "ready", "failed", "unknown"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "$comment": "X4",
      "if": {
        "properties": { "selectedBy": { "enum": ["bundled", "auto", "preset"] } },
        "required": ["selectedBy"]
      },
      "then": { "properties": { "languageMatch": { "not": { "const": false } } } }
    },
    "completion": {
      "type": "object",
      "required": ["requestStatus", "traversalStatus", "semanticScope", "indexingStatus"],
      "properties": {
        "requestStatus": { "enum": ["succeeded", "partial", "failed"] },
        "traversalStatus": {
          "enum": [
            "exhausted", "depth-limited", "node-limited", "timeout",
            "cancelled", "unknown", "failed", "not-started"
          ]
        },
        "semanticScope": {
          "enum": ["provider-static", "static-plus-inference", "static-plus-observation", "none"]
        },
        "indexingStatus": { "enum": ["ready", "working", "unknown"] }
      },
      "additionalProperties": false
    },
    "limitationDetail": {
      "type": "object",
      "required": ["code", "severity", "scope", "message"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["info", "warning", "error"] },
        "scope": { "enum": ["traversal", "semantic", "indexing", "provider", "request"] },
        "message": { "type": "string" },
        "action": { "type": "string" }
      },
      "additionalProperties": false
    },
    "indexingEvidence": {
      "type": "object",
      "required": ["signal"],
      "properties": {
        "signal": { "type": "string" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["traversal", "semantic", "indexing", "reasons"],
      "properties": {
        "traversal": {
          "type": "object",
          "required": ["status", "requestedDepth", "reachedDepth", "maxNodes"],
          "properties": {
            "status": { "enum": ["complete", "depth-limited", "node-limited", "timeout", "failed"] },
            "requestedDepth": { "type": "integer", "minimum": 1 },
            "reachedDepth": { "type": "integer", "minimum": 0 },
            "maxNodes": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "semantic": {
          "type": "object",
          "required": ["status", "evidenceSources"],
          "properties": {
            "status": { "enum": ["static-only", "augmented"] },
            "evidenceSources": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "indexing": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["ready", "working", "unknown"] },
            "evidence": { "$ref": "#/$defs/indexingEvidence" }
          },
          "additionalProperties": false,
          "$comment": "X3",
          "if": { "properties": { "status": { "const": "ready" } }, "required": ["status"] },
          "then": { "required": ["evidence"] }
        },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["cli", "node", "runner"],
      "properties": {
        "cli": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "@impact-lens/cli" },
            "version": { "type": "string" }
          },
          "additionalProperties": false
        },
        "node": {
          "type": "object",
          "required": ["version", "major", "executable"],
          "properties": {
            "version": { "type": "string" },
            "major": { "type": "integer" },
            "executable": { "type": "string" }
          },
          "additionalProperties": false
        },
        "runner": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": { "enum": ["direct", "explicit", "checkout", "global", "release-fallback"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "operation", "ok", "runtime"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operation": {
      "enum": ["impact.analyze", "note.get", "note.list", "note.set", "note.delete", "provider.doctor", "unknown"]
    },
    "ok": { "type": "boolean" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "data": { "type": "object" },
    "capabilities": { "type": "object" },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "timings": { "type": "object" },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": {}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } } },
      "then": {
        "required": ["data", "capabilities", "limitations", "timings"],
        "properties": {
          "data": {},
          "capabilities": {},
          "limitations": {},
          "timings": {}
        }
      },
      "else": {
        "$comment": "X2 - a provider failure may not be reported as a successful empty graph",
        "required": ["error"],
        "properties": { "error": {} },
        "not": { "anyOf": [{ "required": ["data"] }, { "required": ["capabilities"] }] }
      }
    },
    {
      "if": {
        "properties": {
          "ok": { "const": true },
          "operation": { "const": "impact.analyze" }
        },
        "required": ["ok", "operation"]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["provider", "coverage", "completion", "complete", "truncated", "traversalLimits", "nodes", "limitationDetails"],
            "properties": {
              "provider": { "$ref": "#/$defs/provider" },
              "coverage": { "$ref": "#/$defs/coverage" },
              "completion": { "$ref": "#/$defs/completion" },
              "complete": { "type": "boolean" },
              "truncated": { "type": "boolean" },
              "traversalLimits": { "type": "array", "items": { "enum": ["depth", "nodes"] } },
              "nodes": { "type": "array" },
              "limitationDetails": { "type": "array", "items": { "$ref": "#/$defs/limitationDetail" } }
            },
            "allOf": [
              {
                "$comment": "X1 - complete is the v1 spelling of an exhausted traversal, not an independent field",
                "if": {
                  "required": ["coverage"],
                  "properties": { "coverage": { "properties": { "traversal": { "properties": { "status": { "const": "complete" } } } } } }
                },
                "then": { "properties": { "complete": { "const": true } } },
                "else": { "properties": { "complete": { "const": false } } }
              },
              {
                "$comment": "X1 - and the same tie in the other direction, against the completion",
                "if": {
                  "required": ["completion"],
                  "properties": { "completion": { "properties": { "traversalStatus": { "const": "exhausted" } } } }
                },
                "then": {
                  "properties": {
                    "complete": { "const": true },
                    "truncated": { "const": false },
                    "completion": { "properties": { "requestStatus": { "const": "succeeded" } } }
                  }
                },
                "else": { "properties": { "complete": { "const": false }, "truncated": { "const": true } } }
              },
              {
                "$comment": "X2 - a successful analysis always contains the root, so an empty graph is unrepresentable",
                "properties": { "nodes": { "minItems": 1 } }
              },
              {
                "$comment": "X5 - a succeeded request cannot have a bounded traversal",
                "if": {
                  "required": ["completion"],
                  "properties": { "completion": { "properties": { "requestStatus": { "const": "succeeded" } } } }
                },
                "then": { "properties": { "completion": { "properties": { "traversalStatus": { "const": "exhausted" } } } } }
              },
              {
                "$comment": "X6 and X8 - a failed request state and a semantic scope of none belong to an ok:false envelope",
                "properties": {
                  "completion": {
                    "properties": {
                      "requestStatus": { "not": { "const": "failed" } },
                      "semanticScope": { "not": { "const": "none" } }
                    }
                  }
                }
              },
              {
                "$comment": "X7 - an exhausted traversal cannot carry a reason that says it stopped early",
                "if": {
                  "required": ["coverage"],
                  "properties": { "coverage": { "properties": { "traversal": { "properties": { "status": { "const": "complete" } } } } } }
                },
                "then": {
                  "properties": {
                    "coverage": {
                      "properties": {
                        "reasons": {
                          "items": {
                            "not": {
                              "enum": [
                                "depth_limit_reached", "node_limit_reached", "traversal_timeout",
                                "traversal_cancelled", "provider_not_ready"
                              ]
                            }
                          }
                        }
                      }
                    },
                    "limitationDetails": {
                      "items": {
                        "properties": {
                          "code": {
                            "not": {
                              "enum": [
                                "depth_limit_reached", "node_limit_reached", "traversal_timeout",
                                "traversal_cancelled", "provider_not_ready"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "$comment": "X9 - an index that is still working cannot belong to a succeeded request",
                "if": {
                  "required": ["completion"],
                  "properties": { "completion": { "properties": { "indexingStatus": { "const": "working" } } } }
                },
                "then": { "properties": { "completion": { "properties": { "requestStatus": { "enum": ["partial", "failed"] } } } } }
              },
              {
                "$comment": "X10 - a graph that was not truncated cannot list a limit it hit",
                "if": { "required": ["truncated"], "properties": { "truncated": { "const": false } } },
                "then": { "properties": { "traversalLimits": { "maxItems": 0 } } }
              },
              {
                "$comment": "X11 - provider_not_ready and no_incoming_callers make incompatible claims",
                "not": {
                  "allOf": [
                    {
                      "required": ["limitationDetails"],
                      "properties": { "limitationDetails": { "contains": { "required": ["code"], "properties": { "code": { "const": "provider_not_ready" } } } } }
                    },
                    {
                      "required": ["limitationDetails"],
                      "properties": { "limitationDetails": { "contains": { "required": ["code"], "properties": { "code": { "const": "no_incoming_callers" } } } } }
                    }
                  ]
                }
              }
            ]
          },
          "capabilities": { "$ref": "#/$defs/provider" }
        }
      }
    }
  ],
  "additionalProperties": false
}
