{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // M4 gate 2 shared-adapter lane (docs/work/task-m4-gate2-shared-adapter.md): the VS Code extension
    // imports `dist/shared/**` directly (a plain relative `require()`/`import`, not a TypeScript project
    // reference - project references were tried first and rejected, see the work document's "공유
    // 메커니즘" section: importing from `../cli/src/...` type-checks fine under a reference but resolves
    // to a `.ts` path at runtime with no compiled `.js` there, a real `Cannot find module` reproduced
    // directly before this line existed; importing from `../cli/dist/...` instead needs nothing but a
    // `.d.ts` sitting next to each `.js`, which is what this flag alone provides - no `composite`, no
    // `references`, no `.tsbuildinfo`). Lands under `dist/`, already fully gitignored, and is not listed
    // in `package.json`'s "files" (npm-publish allow-list, `.js` only), so this has no effect on what the
    // CLI itself ships via its own standalone packaging.
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  // IL-LIM-001 stage 3 (docs/work/task-il-lim-001-stage3-callback-adapter-design.md). This fixture
  // workspace is a SEPARATE analysis target for the dynamic-callback adapter's own spawned
  // `bundled-typescript` language server (its own tsconfig.json, no explicit `lib`, so it gets DOM by
  // default) - not code this CLI project itself needs compiled, the same role the Python fixtures under
  // `src/test/fixtures/python-fastapi/` already play for the FastAPI adapter. Those never collided with
  // this config because `include` only ever matched `.ts`; this one uses `.ts` on purpose (the fixture
  // needs to be real TypeScript, analyzed by a real TypeScript language server) and needs excluding
  // explicitly, or `tsc -p .` fails on `HTMLButtonElement` under this project's own `lib: ["ES2022"]`
  // (no DOM) - reproduced directly before adding this line.
  "exclude": ["src/test/fixtures/typescript-dynamic-callback"]
}
